@model Movie

<h2 class="display-6 mb-4">Видалення фільму</h2>

<div class="alert alert-danger">
    <h5>Ви впевнені, що хочете видалити цей фільм?</h5>
</div>

<div class="card">
    <div class="card-body">
        <h4 class="card-title">@Model.Title</h4>
        <table class="table table-borderless">
            <tr>
                <th>Опис</th>
                <td>@Model.Description</td>
            </tr>
            <tr>
                <th>Жанр</th>
                <td>@Model.Genre</td>
            </tr>
            <tr>
                <th>Ціна квитка</th>
                <td>@Model.TicketPrice.ToString("c")</td>
            </tr>
            <tr>
                <th>Зал</th>
                <td>@(Model.CinemaHall?.Name ?? "Не призначено")</td>
            </tr>
        </table>
    </div>
</div>

<div class="mt-3">
    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" name="movieID" value="@Model.MovieID" />
        <button type="submit" class="btn btn-danger">Підтвердити видалення</button>
        <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
    </form>
</div>
