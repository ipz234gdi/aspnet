@model CinemaHall

<h2 class="display-6 mb-4">Деталі залу</h2>

<div class="card">
    <div class="card-body">
        <h4 class="card-title">@Model.Name</h4>
        <table class="table table-borderless">
            <tr>
                <th>ID</th>
                <td>@Model.CinemaHallID</td>
            </tr>
            <tr>
                <th>Місткість</th>
                <td>@Model.Capacity</td>
            </tr>
            <tr>
                <th>Розташування</th>
                <td>@Model.Location</td>
            </tr>
        </table>

        <h5 class="mt-4">Фільми в цьому залі</h5>
        @if (Model.Movies.Any())
        {
            <ul class="list-group">
                @foreach (var movie in Model.Movies)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @movie.Title
                        <span class="badge bg-primary rounded-pill">@movie.TicketPrice.ToString("c")</span>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">Немає фільмів у цьому залі.</p>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.CinemaHallID" class="btn btn-warning">Редагувати</a>
    <a asp-action="Index" class="btn btn-secondary">До списку</a>
</div>
