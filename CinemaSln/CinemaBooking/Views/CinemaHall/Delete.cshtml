@model CinemaHall

<h2 class="display-6 mb-4">Видалення залу</h2>

<div class="alert alert-danger">
    <h5>Ви впевнені, що хочете видалити цей зал?</h5>
</div>

<div class="card">
    <div class="card-body">
        <h4 class="card-title">@Model.Name</h4>
        <table class="table table-borderless">
            <tr>
                <th>Місткість</th>
                <td>@Model.Capacity</td>
            </tr>
            <tr>
                <th>Розташування</th>
                <td>@Model.Location</td>
            </tr>
        </table>
    </div>
</div>

<div class="mt-3">
    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" name="cinemaHallID" value="@Model.CinemaHallID" />
        <button type="submit" class="btn btn-danger">Підтвердити видалення</button>
        <a asp-action="Index" class="btn btn-secondary">Скасувати</a>
    </form>
</div>
