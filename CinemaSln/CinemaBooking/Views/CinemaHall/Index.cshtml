@model List<CinemaHall>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="display-6">Кінозали</h2>
    <a asp-action="Create" class="btn btn-success">Додати зал</a>
</div>

<table class="table table-striped">
    <thead class="table-dark">
        <tr>
            <th>Назва</th>
            <th>Місткість</th>
            <th>Розташування</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var hall in Model)
        {
            <tr>
                <td>@hall.Name</td>
                <td>@hall.Capacity</td>
                <td>@hall.Location</td>
                <td>
                    <a asp-action="Details" asp-route-id="@hall.CinemaHallID" class="btn btn-sm btn-info">Деталі</a>
                    <a asp-action="Edit" asp-route-id="@hall.CinemaHallID" class="btn btn-sm btn-warning">Редагувати</a>
                    <a asp-action="Delete" asp-route-id="@hall.CinemaHallID" class="btn btn-sm btn-danger">Видалити</a>
                </td>
            </tr>
        }
    </tbody>
</table>
