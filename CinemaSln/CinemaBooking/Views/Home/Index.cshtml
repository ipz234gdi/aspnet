@model CinemaBooking.Models.ViewModels.MoviesListViewModel

<div class="text-center mb-4">
    <h2 class="display-6">Доступні кіносеанси</h2>
</div>

<div class="row">
    @foreach (var m in Model.Movies)
    {
        <partial name="MovieSummary" model="m" />
    }
</div>

<nav aria-label="Page navigation" class="mt-4">
    <ul class="pagination justify-content-center">
        @for (int i = 1; i <= Model.PagingInfo.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PagingInfo.CurrentPage ? "active" : "")">
                <a class="page-link"
                   href="/?moviePage=@i@(Model.CurrentGenre != null ? "&genre=" + Model.CurrentGenre : "")">@i</a>
            </li>
        }
    </ul>
</nav>