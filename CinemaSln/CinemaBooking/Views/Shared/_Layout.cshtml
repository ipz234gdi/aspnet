<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Бронювання квитків - CinemaBooking</title>
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-light min-vh-100 d-flex flex-column">

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand" href="/">CinemaBooking</a>
                <div class="ms-auto">
                    @{
                        var cart = Context.Session.GetString("BookingCart");
                        int count = 0;
                        if (cart != null)
                        {
                            var bookingCart = System.Text.Json.JsonSerializer.Deserialize<CinemaBooking.Models.BookingCart>(cart);
                            count = bookingCart?.Items?.Count ?? 0;
                        }
                    }
                    <a href="/Booking" class="btn btn-outline-light">
                        Мої бронювання
                        @if (count > 0)
                        {
                            <span class="badge bg-danger ms-1">@count</span>
                        }
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4" style="flex: 1;">
        <div class="row">
            <div class="col-md-3">
                @await Component.InvokeAsync("NavigationMenu")
            </div>
            <div class="col-md-9">
                @RenderBody()
            </div>
        </div>
    </div>

    <footer class="bg-dark text-white text-center py-3 mt-5">
        <div class="container">
            &copy; 2026 - CinemaBooking
        </div>
    </footer>

</body>
</html>