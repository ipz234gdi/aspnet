<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CinemaBooking</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    
    <script>
        // Prevent FOUC: Apply theme before body renders
        const currentTheme = localStorage.getItem('theme') || 'light';
        if (currentTheme === 'dark') {
            document.documentElement.classList.add('dark-theme');
        }
    </script>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light glass-panel sticky-top">
            <div class="container">
                <a class="navbar-brand" href="/">CINEMA BOOKING</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Movie">Фільми (Admin)</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/CinemaHall">Зали (Admin)</a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var cartKey = $"BookingCart_{User.Identity.Name}";
                            var cart = Context.Session.GetString(cartKey);
                            int count = 0;
                            if (cart != null)
                            {
                                var bookingCart = System.Text.Json.JsonSerializer.Deserialize<CinemaBooking.Data.Models.BookingCart>(cart);
                                count = bookingCart?.Items?.Count ?? 0;
                            }
                            
                            <a href="/Booking" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                                <span>Мої бронювання</span>
                                @if (count > 0)
                                {
                                    <span class="badge bg-danger rounded-pill">@count</span>
                                }
                            </a>
                            <span class="text-secondary fw-medium">@User.Identity.Name</span>
                            <a href="/Account/Profile" class="btn btn-outline-info">Профіль</a>
                            <a href="/Account/Logout" class="btn btn-outline-danger">Вийти</a>
                        }
                        else
                        {
                            <a href="/Account/Login" class="btn btn-outline-secondary">Увійти</a>
                            <a href="/Account/Register" class="btn btn-primary">Реєстрація</a>
                        }
                        
                        <button id="themeToggleBtn" class="theme-toggle-btn">Темна тема</button>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container pb-5 mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="py-4 mt-auto border-top glass-panel">
        <div class="container text-center">
            <span class="text-muted fw-medium">&copy; 2026 - CinemaBooking</span>
        </div>
    </footer>

    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const toggleBtn = document.getElementById('themeToggleBtn');
            if (document.documentElement.classList.contains('dark-theme')) {
                toggleBtn.textContent = 'Світла тема';
            }
            
            toggleBtn.addEventListener('click', () => {
                document.documentElement.classList.toggle('dark-theme');
                if (document.documentElement.classList.contains('dark-theme')) {
                    localStorage.setItem('theme', 'dark');
                    toggleBtn.textContent = 'Світла тема';
                } else {
                    localStorage.setItem('theme', 'light');
                    toggleBtn.textContent = 'Темна тема';
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>