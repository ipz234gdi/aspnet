@model CinemaBooking.Data.Models.Movie

<div class="col-md-6 mb-4">
    <div class="card shadow-sm h-100 border-0">
        <div class="card-body d-flex flex-column">
            <h5 class="card-title fw-bold">@Model.Title</h5>
            <h6 class="card-subtitle mb-3 text-muted">Жанр: @Model.Genre</h6>
            <h6 class="card-subtitle mb-3 text-info">Зал: @(Model.CinemaHall?.Name ?? "Не призначено")</h6>
            <p class="card-text">@Model.Description</p>
            <div class="mt-auto">
                <h4 class="text-success">@Model.TicketPrice.ToString("c")</h4>
                <form asp-controller="Booking" asp-action="AddSeat" method="post" class="mt-2">
                    <input type="hidden" name="movieId" value="@Model.MovieID" />
                    <div class="row g-2 align-items-end">
                        <div class="col">
                            <label class="form-label mb-1">Ряд</label>
                            <select name="row" class="form-select form-select-sm">
                                @for (int r = 1; r <= 5; r++)
                                {
                                    <option value="@r">@r</option>
                                }
                            </select>
                        </div>
                        <div class="col">
                            <label class="form-label mb-1">Місце</label>
                            <select name="seat" class="form-select form-select-sm">
                                @for (int s = 1; s <= 10; s++)
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-sm btn-primary">Забронювати</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
