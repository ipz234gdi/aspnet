@model CinemaBooking.Data.Models.Movie

<div class="movie-card">
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" alt="@Model.Title" class="poster" loading="lazy" />
    }
    else
    {
        <div class="poster-placeholder">
            <span>🎬</span>
        </div>
    }
    
    <div class="card-info">
        <span class="movie-genre">@Model.Genre</span>
        <h3 class="movie-title">@Model.Title</h3>
        <p class="movie-desc">@Model.Description</p>
        
        <div class="card-footer-row">
            <div>
                <div class="movie-price">@Model.TicketPrice.ToString("c")</div>
                <div class="movie-hall">Зал: @(Model.CinemaHall?.Name ?? "Не призначено")</div>
            </div>
            
            <a href="/Booking/SeatMap?movieId=@Model.MovieID" class="btn-book">
                <span>Обрати місце</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                  <path fill-rule="evenodd" d="M4 8a.5.5 0 0 1 .5-.5h5.793L8.146 5.354a.5.5 0 1 1 .708-.708l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708-.708L10.293 8.5H4.5A.5.5 0 0 1 4 8z"/>
                </svg>
            </a>
        </div>
    </div>
</div>
