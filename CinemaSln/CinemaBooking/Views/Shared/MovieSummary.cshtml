@model CinemaBooking.Data.Models.Movie

<div class="movie-card">
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" alt="@Model.Title" class="poster" loading="lazy" onerror="this.onerror=null;this.src='https://dummyimage.com/500x750/1e1e24/71717a&text=Постер+Відсутній';" />
    }
    else
    {
        <div class="poster-placeholder" style="height: 400px; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.05);">
            <span style="font-size: 3rem; color: rgba(255,255,255,0.2);">🎬</span>
        </div>
    }
    
    <div class="movie-date-badge">
        <span class="day">@Model.ShowDate.ToString("dd")</span>
        <span class="time">@Model.ShowDate.ToString("HH:mm")</span>
    </div>

    <div class="card-info">
        <span class="movie-genre">@Model.Genre</span>
        <h3 class="movie-title">@Model.Title</h3>
        <p class="movie-desc">@Model.Description</p>
        
        <div class="card-footer-row mt-auto">
            <div>
                <div class="movie-price">@Model.TicketPrice.ToString("c")</div>
                <div class="text-secondary small fw-bold mt-1">Зал: @(Model.CinemaHall?.Name ?? "Не призначено")</div>
            </div>
            
            <a href="/Booking/SeatMap?movieId=@Model.MovieID" class="btn btn-primary">
                Квитки
            </a>
        </div>
    </div>
</div>
