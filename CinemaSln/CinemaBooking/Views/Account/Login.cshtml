@model CinemaBooking.Models.ViewModels.LoginModel
@{
    Layout = "_AuthLayout";
}

<div class="card shadow-sm">
    <div class="card-body p-4">
        <h4 class="text-center mb-4">Вхід</h4>
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="Name" class="form-label">Ім'я користувача</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Пароль</label>
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100 mt-2">Увійти</button>
        </form>
        <div class="text-center mt-3">
            <span class="text-muted">Немає акаунту?</span>
            <a asp-action="Register">Зареєструватися</a>
        </div>
    </div>
</div>
