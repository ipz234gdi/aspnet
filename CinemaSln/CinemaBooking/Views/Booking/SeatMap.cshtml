@model dynamic
@{
    ViewData["Title"] = "Схема місць";
    var movie = ViewBag.Movie as CinemaBooking.Data.Models.Movie;
    var hallName = ViewBag.HallName as string;
    var rows = (int)ViewBag.Rows;
    var seatsPerRow = (int)ViewBag.SeatsPerRow;
    var myBookedSeats = ViewBag.MyBookedSeats as List<string>;
}

<div class="mb-4">
    <a href="/" class="btn btn-outline-secondary btn-sm mb-3">
        &larr; Назад до фільмів
    </a>
    <div class="section-header">
        <h2>@movie.Title</h2>
        <p>Зал: @hallName &bull; Ціна квитка: @movie.TicketPrice.ToString("c")</p>
    </div>
</div>

<div class="d-flex justify-content-center mb-4">
    <div id="connection-status" class="badge bg-warning text-dark py-2 px-3">Підключення до залу...</div>
</div>

<div class="seat-map-container">
    <div class="screen">
        <div class="screen-label">Екран</div>
    </div>

    <div class="seat-grid">
        @for (int r = 1; r <= rows; r++)
        {
            <div class="seat-row">
                <div class="row-label">Ряд @r</div>
                @for (int s = 1; s <= seatsPerRow; s++)
                {
                    string seatLabel = $"Ряд {r}, Місце {s}";
                    bool isMine = myBookedSeats.Contains(seatLabel);
                    string cssClass = isMine ? "booked-mine" : "available";

                    <button type="button"
                            class="seat @cssClass"
                            data-row="@r"
                            data-seat="@s"
                            onclick="toggleSeat(this, @movie.MovieID, @r, @s)">
                        @s
                    </button>
                }
                <div class="row-label text-end">Ряд @r</div>
            </div>
        }
    </div>

    <div class="seat-legend">
        <div class="legend-item">
            <span class="seat-sample available"></span> Вільно
        </div>
        <div class="legend-item">
            <span class="seat-sample booked-mine"></span> Ваше
        </div>
        <div class="legend-item">
            <span class="seat-sample booked-other"></span> Зайнято
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script>
        var connection = new signalR.HubConnectionBuilder()
            .withUrl("/bookinghub")
            .withAutomaticReconnect()
            .build();

        connection.on("SeatUpdated", function (movieId, row, seat, isBooked) {
            if (movieId != @movie.MovieID) return;

            var btn = document.querySelector(`.seat[data-row='${row}'][data-seat='${seat}']`);
            if (btn) {
                if (btn.classList.contains("booked-mine") && isBooked) {
                    // It's mine, keep it
                    return;
                }
                
                if (isBooked) {
                    btn.className = "seat booked-other";
                } else {
                    btn.className = "seat available";
                }
                
                showNotification(row, seat, isBooked);
            }
        });

        connection.start().then(function () {
            updateStatus("connected");
        }).catch(function (err) {
            updateStatus("disconnected");
        });

        connection.onreconnecting(function () {
            updateStatus("reconnecting");
        });

        connection.onreconnected(function () {
            updateStatus("connected");
        });

        connection.onclose(function () {
            updateStatus("disconnected");
        });

        function updateStatus(state) {
            var el = document.getElementById("connection-status");
            if (state === "connected") {
                el.className = "badge bg-success";
                el.textContent = "Live: Оновлення в реальному часі";
            } else if (state === "reconnecting") {
                el.className = "badge bg-warning text-dark";
                el.textContent = "Перепідключення...";
            } else {
                el.className = "badge bg-danger";
                el.textContent = "Відключено від залу";
            }
        }

        function toggleSeat(btn, movieId, row, seat) {
            if (btn.classList.contains("booked-other")) return;

            // Optimistic update
            var wasMine = btn.classList.contains("booked-mine");
            
            if (wasMine) {
                btn.className = "seat available";
            } else {
                btn.className = "seat booked-mine";
            }

            fetch('/Booking/ToggleSeat', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: new URLSearchParams({
                    movieId: movieId,
                    row: row,
                    seat: seat
                })
            })
            .then(response => response.json())
            .then(data => {
                if (!data.success) {
                    // Revert on failure
                    btn.className = wasMine ? "seat booked-mine" : "seat available";
                } else {
                    // Sync with server state
                    btn.className = data.isBooked ? "seat booked-mine" : "seat available";
                }
            })
            .catch(err => {
                console.error('Error toggling seat:', err);
                // Revert on error
                btn.className = wasMine ? "seat booked-mine" : "seat available";
            });
        }

        function showNotification(row, seat, isBooked) {
            var div = document.createElement("div");
            div.className = "notification " + (isBooked ? "booked" : "released");
            div.textContent = `Місце (Ряд ${row}, Місце ${seat}) було ${isBooked ? 'заброньовано' : 'звільнено'}.`;
            
            document.body.appendChild(div);
            
            setTimeout(() => {
                if (div.parentNode) {
                    div.parentNode.removeChild(div);
                }
            }, 3000);
        }
    </script>
}
