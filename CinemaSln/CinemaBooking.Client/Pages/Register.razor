@page "/register"
@inject AuthService AuthService
@inject NavigationManager Navigation

<h3>Реєстрація</h3>

@if (successMessage != null)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<EditForm Model="registerModel" OnValidSubmit="HandleRegister" FormName="registerForm">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />

    <div class="mb-3">
        <label class="form-label">Ім'я користувача</label>
        <InputText class="form-control" @bind-Value="registerModel.UserName" />
        <ValidationMessage For="@(() => registerModel.UserName)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Електронна пошта</label>
        <InputText class="form-control" @bind-Value="registerModel.Email" />
        <ValidationMessage For="@(() => registerModel.Email)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Пароль</label>
        <InputText class="form-control" type="password" @bind-Value="registerModel.Password" />
        <ValidationMessage For="@(() => registerModel.Password)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Підтвердження пароля</label>
        <InputText class="form-control" type="password" @bind-Value="registerModel.ConfirmPassword" />
        <ValidationMessage For="@(() => registerModel.ConfirmPassword)" />
    </div>

    <button type="submit" class="btn btn-primary">Зареєструватись</button>
    <a href="login" class="btn btn-link">Вже є акаунт? Увійти</a>
</EditForm>

@code {
    private RegisterRequest registerModel = new();
    private string? errorMessage;
    private string? successMessage;

    private async Task HandleRegister()
    {
        var error = await AuthService.Register(registerModel);
        if (error == null)
        {
            successMessage = "Реєстрація успішна! Тепер ви можете увійти.";
            errorMessage = null;
            registerModel = new();
        }
        else
        {
            errorMessage = "Помилка реєстрації. Перевірте дані та спробуйте ще раз.";
            successMessage = null;
        }
    }
}
