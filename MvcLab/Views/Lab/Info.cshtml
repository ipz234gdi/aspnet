@{
    ViewData["Title"] = "Інформація про лабораторну";
}

<div class="text-center">
    <h2>Інформація про лабораторну роботу</h2>
</div>

<table class="table table-bordered table-striped mt-4">
    <thead class="thead-dark">
        <tr>
            <th>Властивість</th>
            <th>Значення</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><strong>Номер лабораторної роботи</strong></td>
            <td>@ViewBag.LabNumber</td>
        </tr>
        <tr>
            <td><strong>Тема</strong></td>
            <td>@ViewBag.Topic</td>
        </tr>
        <tr>
            <td><strong>Мета</strong></td>
            <td>@ViewBag.Purpose</td>
        </tr>
        <tr>
            <td><strong>Виконавець</strong></td>
            <td>@ViewBag.StudentName</td>
        </tr>
    </tbody>
</table>